#!/usr/bin/env bash
# Не даёт закоммитить секреты: токены GitHub и Telegram-ботов, ключи, .env и подобные файлы.
# Включить один раз в папке проекта:   git config core.hooksPath .githooks
# Обойти проверку (только если уверен, что это ложное срабатывание):   git commit --no-verify

# 1) файлы, которым не место в репозитории
blocked=$(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '(^|/)(\.env(\..*)?|[^/]*\.pem|[^/]*\.key|id_rsa[^/]*|\.git-credentials|[^/]*\.sqlite3?|[^/]*\.db)$' \
  | grep -v -E '\.env\.(example|sample)$' || true)

# 2) похожее на секрет в добавляемых строках
patterns='ghp_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,}|gho_[A-Za-z0-9]{30,}|[0-9]{8,10}:[A-Za-z0-9_-]{35}|AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----|sk-[A-Za-z0-9]{32,}|xox[baprs]-[A-Za-z0-9-]{10,}'
hits=$(git diff --cached -U0 --no-color | grep -E '^\+[^+]' | grep -E "$patterns" | cut -c1-80 || true)

if [ -n "$blocked" ] || [ -n "$hits" ]; then
  echo "КОММИТ ОСТАНОВЛЕН: найдено то, что нельзя публиковать." >&2
  if [ -n "$blocked" ]; then
    echo "" >&2; echo "Файлы:" >&2; echo "$blocked" | sed 's/^/  - /' >&2
  fi
  if [ -n "$hits" ]; then
    echo "" >&2; echo "Строки, похожие на токен или ключ (показаны первые 80 символов):" >&2
    echo "$hits" | sed 's/^/  /' >&2
  fi
  echo "" >&2
  echo "Что делать: убери это из коммита (git restore --staged ИМЯ_ФАЙЛА), а если ключ уже где-то светился, перевыпусти его." >&2
  exit 1
fi
exit 0
